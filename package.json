{
  "name": "personal-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <27"
  },
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro build && pagefind --site dist",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "vitest run",
    "new-post": "node scripts/new-post.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "verify:dist": "node scripts/verify-built-site.mjs",
    "verify": "npm run validate:content && npm run check && npm test && npm run build && npm run verify:dist"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.5",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.1.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "cross-env": "10.1.0",
    "pagefind": "1.5.2",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
